# Copy to .env in the repo root (the backend reads it from there)
ENV=development
MONGODB_URI=mongodb://localhost:27017      # or mongomock:// for an in-memory demo DB (data lost on restart)
MONGODB_DB=roomsync
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED when ENV=production
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_SEED_DEMO=false                        # true = load the 60 synthetic demo accounts at startup
DEMO_PASSWORD=RoomSync-demo-1
# Frontend (frontend/.env): VITE_API_URL=   (empty = same origin / Vite proxy)

# Set a long private key to enable the University CSV matching dashboard
UNIVERSITY_ADMIN_KEY=replace-with-a-long-random-secret
